# Local values come from `supabase status`. The anon key only reads platform tables (RLS).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
CORE_API_URL=http://127.0.0.1:8000
CORE_API_TOKEN=dev-token
# No login yet: keep actions off anywhere but your own machine.
DASHBOARD_ACTIONS_ENABLED=true
DASHBOARD_ACTOR=jose
