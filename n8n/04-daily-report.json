{
  "name": "04 · daily report",
  "nodes": [
    {
      "parameters": {
        "content": "## 04 · daily report\nEvery morning at 08:00: the last 24 hours from `GET /stats` (tickets, success rate, latency, cost, decisions, backlog, last evaluation) as one Telegram message.",
        "width": 420,
        "height": 170,
        "color": 4
      },
      "id": "agentdesk-0027",
      "name": "Note 27",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -60
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "agentdesk-0028",
      "name": "Every day at 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://agentdesk-api.senaproject.online/stats",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "agentdesk-0029",
      "name": "Get stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "",
          "name": "agentdesk API (Bearer)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000
    },
    {
      "parameters": {
        "jsCode": "// The day in one Telegram message.\nconst s = $input.first().json;\nconst k = s.kpis;\nconst runs = Number(k.runs_ok_24h) + Number(k.runs_failed_24h);\nconst rate = runs ? (100 * k.runs_ok_24h / runs).toFixed(1) : '—';\nconst d = s.decisions_24h ?? {};\nconst e = s.last_eval;\nconst lines = [\n  '📊 <b>agentdesk · last 24 hours</b>',\n  `Tickets: <b>${k.tickets_24h}</b> · agent runs: ${runs} (${rate}% ok)`,\n  `Latency p50 / p95: ${k.p50_latency_ms} ms / ${k.p95_latency_ms} ms`,\n  `Model cost: $${Number(k.cost_24h_usd).toFixed(4)}`,\n  `Decisions: ${d.executed ?? 0} executed, ${d.rejected ?? 0} rejected, ${d.failed ?? 0} failed`,\n  `Waiting for you: <b>${k.pending_approvals}</b> · dead letters: <b>${k.dead_letters}</b>`,\n  `Fallbacks: ${k.fallbacks_24h} · guard blocks: ${k.guard_blocks_24h}`,\n  e ? `Last eval: ${e.passed}/${e.cases} (${e.pass_rate}%), gate ${e.gate_passed ? 'open ✅' : 'closed ❌'}` : 'No eval run yet',\n];\nreturn [{ json: { text: lines.join('\\n') } }];"
      },
      "id": "agentdesk-0030",
      "name": "Format report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "232114558",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false
        }
      },
      "id": "agentdesk-0031",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram · Gustavo Asistente"
        }
      }
    }
  ],
  "connections": {
    "Every day at 08:00": {
      "main": [
        [
          {
            "node": "Get stats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get stats": {
      "main": [
        [
          {
            "node": "Format report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format report": {
      "main": [
        [
          {
            "node": "Send to Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "timezone": "Europe/Luxembourg",
    "errorWorkflow": "{{ERROR_WORKFLOW_ID}}"
  },
  "pinData": {}
}
