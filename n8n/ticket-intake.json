{
  "name": "agentdesk · ticket intake",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agentdesk/intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1f0c6a2-0001-4e1a-9a10-000000000001",
      "name": "Inbound message",
