      "webhookId": "agentdesk-intake"
    },
    {
      "parameters": {
        "jsCode": "// Accepts the shapes a form or a chat widget sends and produces the API's ticket.\nconst b = $input.first().json.body ?? {};\nconst email = String(b.email ?? b.customer_email ?? '').trim().toLowerCase();\nconst body = String(b.message ?? b.body ?? '').trim();\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email) || !body) {\n  return [{ json: { valid: false, error: 'email and message are required' } }];\n}\nreturn [{\n  json: {\n    valid: true,\n    ticket: {\n      channel: b.channel === 'chat' ? 'chat' : 'form',\n      customer_email: email,\n      subject: b.subject ?? null,\n      body: body.slice(0, 10000),\n      // The sender's own id makes a redelivered message one ticket, not two.\n      external_id: b.id ? `n8n-${b.id}` : undefined,\n    },\n  },\n}];"
      },
      "id": "a1f0c6a2-0002-4e1a-9a10-000000000002",
      "name": "Normalize and validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c6a2-0003-4e1a-9a10-000000000003",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://agentdesk-api.senaproject.online/tickets",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.ticket) }}",
        "options": { "timeout": 10000 }
      },
      "id": "a1f0c6a2-0004-4e1a-9a10-000000000004",
      "name": "Create ticket (agentdesk API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 200],
