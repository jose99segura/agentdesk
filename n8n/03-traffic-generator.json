{
  "name": "03 · traffic generator",
  "nodes": [
    {
      "parameters": {
        "content": "## 03 · traffic generator\nKeeps the demo alive: every 15 minutes, between 08:00 and 22:00 Luxembourg time, 1–3 simulated customers write in through `POST /simulate`.\n\nThe store and its customers are synthetic; everything after the API (queue, agents, guards, approvals, tracing) is the real platform. Deactivate this workflow to stop the traffic.",
        "width": 460,
        "height": 230,
        "color": 4
      },
      "id": "agentdesk-0023",
      "name": "Note 23",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -60
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "agentdesk-0024",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Quiet at night, like a real shop; a varying burst during the day.\nconst hour = Number(new Date().toLocaleString('en-GB', { hour: '2-digit', hour12: false, timeZone: 'Europe/Luxembourg' }));\nif (hour < 8 || hour >= 22) return [];\nreturn [{ json: { count: 1 + Math.floor(Math.random() * 3) } }];"
      },
      "id": "agentdesk-0025",
      "name": "Daytime only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://agentdesk-api-pzm2fnni7a-ew.a.run.app/simulate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ count: $json.count }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "agentdesk-0026",
      "name": "Simulate customers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "YwSzDSgZ2hfqO1Ts",
          "name": "agentdesk API (Bearer)"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Daytime only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daytime only": {
      "main": [
        [
          {
            "node": "Simulate customers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "timezone": "Europe/Luxembourg",
    "errorWorkflow": "{{ERROR_WORKFLOW_ID}}"
  },
  "pinData": {}
}
