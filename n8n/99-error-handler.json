      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram · Gustavo Asistente"
        }
      }
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "Alert on Telegram",
            "type": "main",
            "index": 0
          }
