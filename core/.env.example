# Local defaults work against `supabase start` without any of these set.
DATABASE_URL_AGENT=postgresql://desk_agent:desk_agent_dev@127.0.0.1:54322/postgres
DATABASE_URL_API=postgresql://desk_api:desk_api_dev@127.0.0.1:54322/postgres
API_TOKEN=dev-token
API_URL=http://127.0.0.1:8000

# Model chain, tried in order; providers without a key are skipped.
MODEL_CHAIN=mistral,anthropic,offline
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ALLOW_OFFLINE_MODEL=true

# Langfuse (self-hosted on Coolify). Without keys tracing is a no-op.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://langfuse.senaproject.online
LANGFUSE_ENVIRONMENT=agentdesk-dev

# Telegram approvals and alerts (`agentdesk telegram`). Only this chat may decide.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CARDS_PER_HOUR=20
DASHBOARD_URL=http://localhost:3020

WORKER_ID=worker-1
WORKER_CONCURRENCY=3
